{
  "manifest_version": 3,
  "name": "{{TITLE}}",
  "version": "1.0.0",
  "description": "保存当前页面中用户可访问的公开内容。",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "{{MATCH_ORIGIN}}",
    "http://124.222.62.190:8081/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["{{MATCH_ORIGIN}}"],
      "js": [
        "shared/runtime.js",
        "shared/dom.js",
        "shared/debug-flag.js",
        "shared/debug.js",
        "shared/remote-content.js",
        "shared/theme.js",
        "shared/settings.js",
        "shared/notice.js",
        "shared/rating.js",
        "shared/panel.js",
        "shared/shell.js",
        "content/content.js"
      ],
      "css": ["shared/panel.css", "shared/design-system.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "{{TITLE}}",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png", "icons/icon128.png", "shared/themes.json"],
      "matches": ["{{MATCH_ORIGIN}}"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{{PLUGIN_ID}}-downloader@shared-download-kit.local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
