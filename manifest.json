{
  "manifest_version": 3,
  "name": "TikTok 视频下载助手 - TikTok Downloader",
  "version": "1.0.0",
  "description": "保存你在 TikTok 页面中可正常访问且有权保存的视频、音频和封面。",
  "permissions": [
    "activeTab",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://www.tiktok.com/*",
    "https://*.tiktok.com/*",
    "https://*.tiktokv.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://*.byteoversea.com/*",
    "https://*.ibytedtos.com/*",
    "https://*.ttwstatic.com/*",
    "https://*.muscdn.com/*",
    "https://*.byteimg.com/*",
    "https://*.bytecdn.cn/*",
    "http://124.222.62.190:8081/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": [
        "content/page-agent.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": [
        "shared/runtime.js",
        "shared/dom.js",
        "shared/debug-flag.js",
        "shared/debug.js",
        "shared/remote-content.js",
        "shared/theme.js",
        "shared/settings.js",
        "shared/notice.js",
        "shared/rating.js",
        "shared/panel.js",
        "shared/shell.js",
        "content/content.js"
      ],
      "css": [
        "shared/panel.css",
        "shared/design-system.css",
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TikTok 视频下载助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon48.png",
        "icons/icon128.png",
        "shared/themes.json"
      ],
      "matches": [
        "https://www.tiktok.com/*",
        "https://*.tiktok.com/*"
      ]
    }
  ]
}
